# Maintainer: Aditya Krishnan <aditya.krishnan005@gmail.com>
pkgname=screenguard-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="ScreenGuard — Digital Wellbeing for Linux (Screen time tracking, daily app limits & focus mode)"
arch=('x86_64')
url="https://github.com/adityakrishnan005-a11y/ScreenGuard"
license=('GPL-3.0-only')
depends=('xdotool' 'xorg-xprop' 'gtk3' 'sqlite' 'gnome-shell')
provides=('screenguard')
conflicts=('screenguard' 'screenguard-git')
source=("https://github.com/adityakrishnan005-a11y/ScreenGuard/releases/download/v${pkgver}/screenguard-${pkgver}-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
  install -d "$pkgdir/opt/screenguard"
  cp -r "$srcdir/screenguard/"* "$pkgdir/opt/screenguard/"

  install -d "$pkgdir/usr/bin"
  ln -s /opt/screenguard/screenguard "$pkgdir/usr/bin/screenguard"
  ln -s /opt/screenguard/screenguard-daemon "$pkgdir/usr/bin/screenguard-daemon"

  install -Dm644 "$srcdir/screenguard/linux/screenguard.service" "$pkgdir/usr/lib/systemd/user/screenguard.service"
  install -Dm644 "$srcdir/screenguard/linux/screenguard.desktop" "$pkgdir/usr/share/applications/screenguard.desktop"

  # GNOME Shell extension
  install -d "$pkgdir/usr/share/gnome-shell/extensions/screenguard@screenguard.app"
  install -Dm644 "$srcdir/screenguard/extension/metadata.json" "$pkgdir/usr/share/gnome-shell/extensions/screenguard@screenguard.app/metadata.json"
  install -Dm755 "$srcdir/screenguard/extension/extension.js" "$pkgdir/usr/share/gnome-shell/extensions/screenguard@screenguard.app/extension.js"
}
