package() {
  cd "$srcdir"

  # Core application bundle -> /opt/screenguard
  install -d "$pkgdir/opt/screenguard"
  cp -a screenguard screenguard-daemon data lib "$pkgdir/opt/screenguard/"
  for helper in screenguard-watchdog screenguard-notify screenguard-killer; do
    [ -f "$srcdir/$helper" ] && install -Dm755 "$srcdir/$helper" "$pkgdir/opt/screenguard/$helper"
  done

  # App icon
  install -Dm644 "$srcdir/icon.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/screenguard.png"

  # Executable symlinks in PATH
  install -d "$pkgdir/usr/bin"
  for bin in screenguard screenguard-daemon screenguard-watchdog screenguard-notify screenguard-killer; do
    [ -e "$pkgdir/opt/screenguard/$bin" ] && ln -s "/opt/screenguard/$bin" "$pkgdir/usr/bin/$bin"
  done

  # systemd user service, preset, desktop launcher, and autostart
  install -Dm644 "$srcdir/screenguard.service" "$pkgdir/usr/lib/systemd/user/screenguard.service"
  install -Dm644 "$srcdir/50-screenguard.preset" "$pkgdir/usr/lib/systemd/user-preset/50-screenguard.preset"
  install -Dm644 "$srcdir/screenguard.desktop" "$pkgdir/usr/share/applications/screenguard.desktop"
  install -Dm644 "$srcdir/org.screenguard.ScreenGuard.appdata.xml" "$pkgdir/usr/share/metainfo/org.screenguard.ScreenGuard.appdata.xml"
  install -Dm644 "$srcdir/screenguard-autostart.desktop" "$pkgdir/etc/xdg/autostart/screenguard-autostart.desktop"

  # Helper scripts
  install -Dm755 "$srcdir/active_window_helper.py" "$pkgdir/usr/share/screenguard/active_window_helper.py"
  install -Dm755 "$srcdir/enable_fedora_a11y.sh" "$pkgdir/usr/share/screenguard/enable_fedora_a11y.sh"
  install -Dm755 "$srcdir/migrate.sh" "$pkgdir/usr/share/screenguard/migrate.sh"

  # GNOME Shell extension
  install -d "$pkgdir/usr/share/gnome-shell/extensions/screenguard@screenguard.app"
  install -Dm644 "$srcdir/metadata.json" "$pkgdir/usr/share/gnome-shell/extensions/screenguard@screenguard.app/metadata.json"
  install -Dm755 "$srcdir/extension.js" "$pkgdir/usr/share/gnome-shell/extensions/screenguard@screenguard.app/extension.js"
}
