# Maintainer: Aditya Krishnan <aditya.krishnan005@gmail.com>
pkgname=screenguard-bin
pkgver=1.1.2
pkgrel=1
pkgdesc="ScreenGuard — Digital Wellbeing for Linux (Screen time tracking, daily app limits & focus mode)"
arch=('x86_64')
url="https://github.com/adityakrishnan005-a11y/ScreenGuard"
license=('GPL-3.0-only')
depends=('xdotool' 'xorg-xprop' 'gtk3' 'sqlite' 'xprintidle')
options=(!debug !strip)
optdepends=(
  'gnome-shell: GNOME Shell extension support (primary Wayland backend)'
  'python: active window helper script'
  'python-pyatspi: accessibility bus support for window tracking'
)
provides=('screenguard')
conflicts=('screenguard' 'screenguard-git')
source=(
  "$pkgname-$pkgver-x86_64.tar.gz::https://github.com/adityakrishnan005-a11y/ScreenGuard/releases/download/v$pkgver/screenguard-$pkgver-x86_64.tar.gz"
  "screenguard.service::https://raw.githubusercontent.com/adityakrishnan005-a11y/ScreenGuard/v$pkgver/linux/screenguard.service"
  "50-screenguard.preset::https://raw.githubusercontent.com/adityakrishnan005-a11y/ScreenGuard/v$pkgver/linux/50-screenguard.preset"
  "screenguard.desktop::https://raw.githubusercontent.com/adityakrishnan005-a11y/ScreenGuard/v$pkgver/linux/screenguard.desktop"
  "screenguard-autostart.desktop::https://raw.githubusercontent.com/adityakrishnan005-a11y/ScreenGuard/v$pkgver/linux/screenguard-autostart.desktop"
  "icon.png::https://raw.githubusercontent.com/adityakrishnan005-a11y/ScreenGuard/v$pkgver/linux/resources/icon.png"
  "active_window_helper.py::https://raw.githubusercontent.com/adityakrishnan005-a11y/ScreenGuard/v$pkgver/bin/active_window_helper.py"
  "enable_fedora_a11y.sh::https://raw.githubusercontent.com/adityakrishnan005-a11y/ScreenGuard/v$pkgver/tools/enable_fedora_a11y.sh"
  "migrate.sh::https://raw.githubusercontent.com/adityakrishnan005-a11y/ScreenGuard/v$pkgver/tools/migrate.sh"
  "metadata.json::https://raw.githubusercontent.com/adityakrishnan005-a11y/ScreenGuard/v$pkgver/extension/metadata.json"
  "extension.js::https://raw.githubusercontent.com/adityakrishnan005-a11y/ScreenGuard/v$pkgver/extension/extension.js"
  "org.screenguard.ScreenGuard.appdata.xml::https://raw.githubusercontent.com/adityakrishnan005-a11y/ScreenGuard/v$pkgver/packaging/org.screenguard.ScreenGuard.appdata.xml"
)
sha256sums=(
  '612de79693f19f9ebd4b51efa4054d08b36d5780d2594bcdfa296259eb544ed1'
  '3c4e9707079f6fd369436376aa94d59874f516f069f1f3f7c3054afe3c374ea3'
  'a521de5318b9413a57e52b24d0c43456a9509eb140454d28e2e143f9efafd654'
  'eef09f0c07aa64c2b143a9b417bdd51665c8a382ba6d0599b65b4901ea795135'
  'abfbcaa026c4ddb9a3afcd664c7da26bcfabd216959922f3a0bd1be9d31be6d0'
  'd865be21e90d039d0ee05b246ff07bc708000ed659f5895acb2721a829293098'
  '4c9c89af603dbf3fd9f7f2f729d5ba34fe5f32fb77fd2dcd08bad606aa11eb88'
  'df04e5369ac029e9754a9bc591f340efbff30a203581cd51e5fccec0341ae3e2'
  '87c8781dd3af27cd59bf63fd98787d3c2553c2266d7d130d703a80561202ef3a'
  'cde88216e41a390bf2f6b43f19b3ac74577ad91ea265c79e2e72946ca2c4b186'
  'c47209177ff3787dd1e15fff515db6f10cdd912ffa7b0ca4078929aaef903f8b'
