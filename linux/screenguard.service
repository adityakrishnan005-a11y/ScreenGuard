[Unit]
Description=ScreenGuard Tracker Daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/screenguard-daemon
# Our SIGTERM handler exits in milliseconds; a short stop timeout keeps
# logout/reboot snappy instead of hanging on a wedged daemon.
TimeoutStopSec=10
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
