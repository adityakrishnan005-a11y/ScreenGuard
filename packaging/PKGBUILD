# Maintainer: Aditya Krishnan <aditya.krishnan005@gmail.com>
pkgname=screenguard
pkgver=0.1.0
pkgrel=1
pkgdesc="Screen time tracker for Linux (Flutter GUI + Dart daemon)"
arch=('x86_64')
url="https://github.com/adityakrishnan005-a11y/ScreenGuard"
license=('GPL-3.0-only')
depends=('xdotool' 'xorg-xprop' 'gtk3' 'sqlite')
options=(!debug !strip)
optdepends=(
  'xprintidle: idle-time detection on X11 (required for KDE/X11 sessions)'
  'gnome-shell: GNOME Shell extension support (primary Wayland backend)'
  'python: active window helper script'
)
provides=('screenguard')
conflicts=('screenguard-git')
source=("$pkgname-$pkgver-x86_64.tar.gz::https://github.com/adityakrishnan005-a11y/ScreenGuard/releases/download/v$pkgver/$pkgname-$pkgver-x86_64.tar.gz")
sha256sums=('b388c96086ace8dd23650c1498bd379560ba6f1628fa63f8c65a512606b3a770')

package() {
  cd "$srcdir/screenguard"

  # Core application bundle -> /opt/screenguard
  install -d "$pkgdir/opt/screenguard"
  cp -a screenguard screenguard-daemon data lib "$pkgdir/opt/screenguard/"

  # App icon
  install -Dm644 linux/resources/icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/screenguard.png"

  # Executable symlinks in PATH
  install -d "$pkgdir/usr/bin"
  ln -s /opt/screenguard/screenguard "$pkgdir/usr/bin/screenguard"
  ln -s /opt/screenguard/screenguard-daemon "$pkgdir/usr/bin/screenguard-daemon"

  # systemd user service + desktop file
  install -Dm644 linux/screenguard.service "$pkgdir/usr/lib/systemd/user/screenguard.service"
  install -Dm644 linux/screenguard.desktop "$pkgdir/usr/share/applications/screenguard.desktop"

  # Helper scripts
  install -Dm755 bin/active_window_helper.py "$pkgdir/usr/share/screenguard/active_window_helper.py"
  install -Dm755 tools/enable_fedora_a11y.sh "$pkgdir/usr/share/screenguard/enable_fedora_a11y.sh"

  # GNOME Shell extension
  install -d "$pkgdir/usr/share/gnome-shell/extensions/screenguard@screenguard.app"
  install -Dm644 extension/metadata.json "$pkgdir/usr/share/gnome-shell/extensions/screenguard@screenguard.app/metadata.json"
  install -Dm755 extension/extension.js "$pkgdir/usr/share/gnome-shell/extensions/screenguard@screenguard.app/extension.js"
}
